#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	export CGO_ENABLED=0
	export GOOS=linux
	cd /build && make build-go

override_dh_auto_install:
	mkdir -p debian/twindb-backup/usr/bin
	mkdir -p debian/twindb-backup/lib/systemd/system
	mkdir -p debian/twindb-backup/usr/share/doc/twindb-backup
	cp /build/bin/twindb-backup debian/twindb-backup/usr/bin/
	cp /build/packaging/systemd/twindb-backup@.service debian/twindb-backup/lib/systemd/system/
	cp /build/packaging/systemd/twindb-backup@.timer debian/twindb-backup/lib/systemd/system/
	cp /build/LICENSE debian/twindb-backup/usr/share/doc/twindb-backup/
	cp /build/docs/GO_REWRITE.md debian/twindb-backup/usr/share/doc/twindb-backup/

override_dh_systemd_enable:
	dh_systemd_enable --name=twindb-backup@

override_dh_systemd_start:
	dh_systemd_start --name=twindb-backup@ --no-start
